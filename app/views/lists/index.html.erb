<div class="banner" style="background-image: linear-gradient(rgba(0,0,0,0.3), rgba(0,0,0,0.3)), url(https://i.pinimg.com/736x/70/43/8d/70438dc6bc30d9fbd80af98f4034141e.jpg)">
  Movie Pop
</div>
<div class="text-center my-5">
  <h2 class="display-6 fw-bold mb-1">My Movie Lists</h2>
  <p class="text-muted">Pick a genre to see its movies</p>
</div>

<div class="cards">
  <% @lists.each do |list| %>
    <%= link_to list.name, list_path(list),
          class: "card-category",
          style: "background-image: linear-gradient(rgba(0,0,0,0.3), rgba(0,0,0,0.3)), url(#{list_image_url(list)})" %>
  <% end %>
</div>

<div class="text-center my-5">
  <%= link_to "+ New list", new_list_path, class: "btn btn-primary btn-lg px-6" %>
</div>
